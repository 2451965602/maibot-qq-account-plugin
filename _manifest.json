{
  "manifest_version": 2,
  "id": "fjyxyz.qq-account",
  "version": "1.0.6",
  "name": "QQ 账号管理",
  "description": "通过 SnowLuma 管理机器人自身 QQ 资料、在线状态与 QQ 空间黑名单，仅允许主人调用。",
  "author": {"name": "fjyxyz", "url": "https://github.com/2451965602"},
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/2451965602/maibot-qq-account-plugin",
    "homepage": "https://github.com/2451965602/maibot-qq-account-plugin",
    "documentation": "https://github.com/2451965602/maibot-qq-account-plugin#readme",
    "issues": "https://github.com/2451965602/maibot-qq-account-plugin/issues"
  },
  "plugin_type": "tool",
  "host_application": {"min_version": "1.3.0", "max_version": "1.3.99"},
  "sdk": {"min_version": "2.5.0", "max_version": "2.16.99"},
  "dependencies": [{"type": "plugin", "id": "maibot-team.snowluma-adapter", "version_spec": ">=1.0.1"}],
  "capabilities": ["api.call", "chat.get_stream_by_user_id"],
  "i18n": {"default_locale": "zh-CN", "supported_locales": ["zh-CN"]}
}
